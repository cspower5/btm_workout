:root {
  --primary-color: #007bff;
  --secondary-color: #6c757d;
  --background-color: #f8f9fa;
  --card-background: #ffffff;
  --text-color: #212529;
  --border-radius: 8px;
  --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 
  'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  margin: 0;
  padding: 0;
  background-color: var(--background-color);
  color: var(--text-color);
}

.App {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  text-align: center;
}

.App-header {
  background-color: #1E90FF;
  min-height: 320px; /* Reduced header for better form accessibility */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  font-size: calc(10px + 2vmin);
  color: white;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  padding: 1rem 1.5rem;
}

/* User info positioned in upper right */
.user-info-section {
  position: absolute;
  top: 1rem;
  right: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.user-info-section {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 1rem;
}

.App-header h1 {
  margin: 0 0 0.5rem 0;
  /* reduced default header title size for better mobile/desktop balance */
  font-size: 1.8rem;
}

/* Header logo styling - rectangular for better fit */
.header-logo {
  width: 380px;   /* Still prominent rectangular logo */
  height: 152px;  /* 5:2 aspect ratio maintained */
  object-fit: contain;
  margin: 0.5rem auto 0.75rem auto;
}

/* Position navigation at bottom of header with padding */
.header-nav {
  margin-top: auto; /* Push to bottom of header */
  margin-bottom: 1rem; /* Reasonable padding from bottom edge */
  width: 100%;
}.user-welcome {
  color: white;
  font-size: 1rem;
  font-weight: 500;
}

.logout-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 0.4rem 0.8rem;
  border-radius: 4px;
  font-size: 0.8rem;
  cursor: pointer;
  transition: background-color 0.2s;
}

.logout-btn:hover {
  background-color: rgba(255, 255, 255, 0.3);
}

/* Hamburger button (hidden on larger screens) */
.hamburger {
  display: none; /* shown via media query */
  background: transparent;
  border: none;
  padding: 0.25rem;
  margin-left: 0.5rem;
  cursor: pointer;
  color: white;
}

.hamburger-box { display: inline-block; width: 28px; height: 18px; position: relative; }
.hamburger-inner,
.hamburger-inner::before,
.hamburger-inner::after {
  width: 28px;
  height: 2px;
  background-color: white;
  display: block;
  position: absolute;
  left: 0;
  transition: transform 0.25s ease, opacity 0.25s ease;
}
.hamburger-inner { top: 50%; transform: translateY(-50%); }
.hamburger-inner::before { content: ''; top: -8px; }
.hamburger-inner::after { content: ''; top: 8px; }
.hamburger.open .hamburger-inner { background-color: transparent; }
.hamburger.open .hamburger-inner::before { transform: translateY(8px) rotate(45deg); }
.hamburger.open .hamburger-inner::after { transform: translateY(-8px) rotate(-45deg); }


@media (max-width: 600px) {
  .App-header {
    min-height: 260px; /* Reduced mobile header for form accessibility */
    padding: 0.45rem 0.6rem !important;
    position: fixed !important;
    top: 0; left: 0; right: 0; z-index: 1000;
  }

  .App-header h1 {
    font-size: 1.4rem !important;
    margin-bottom: 0.3rem;
  }

  /* Smaller logo on mobile */
  .header-logo {
    width: 266px;    /* Proportional mobile logo */
    height: 106px;   /* 5:2 rectangular ratio maintained */
    object-fit: contain;
    margin: 0.5rem auto 0.5rem auto;
  }

  /* User info section for mobile */
  .user-info-section {
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
  }

  .user-welcome {
    font-size: 0.85rem;
    text-align: right;
  }

  .logout-btn {
    padding: 0.2rem 0.5rem;
    font-size: 0.7rem;
  }

  /* Mobile main content padding */
  main { 
    padding-top: 320px !important; 
    padding-bottom: 56px !important;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  /* Special mobile spacing for auth pages */
  main .auth-page-container {
    padding-top: 420px !important;
  }

  /* show hamburger and hide nav by default on small screens */
  .hamburger { display: inline-flex; align-items: center; justify-content: center; }
  .header-nav { display: none; width: 100%; }
  .header-nav.open { 
    display: block; 
    position: fixed; /* Make it stick/pop-out */
    top: 200px; /* Position right below the fixed header */
    width: 90%; /* Use 90% of the viewport width */
    max-width: 280px; /* Cap the width at 280px for larger phones */
    right: 10px; /* Anchor it to the right side of the screen */
    z-index: 999; /* Ensure it's on top of everything but below the fixed header (z-index 1000) */
    background-color: var(--primary-color); /* Use a solid color for the overlay background */
    overflow-y: auto; /* Allow scrolling if the menu is long */
    padding-bottom: 56px; /* Add space for the fixed footer */}

  /* when open, show the nav as a vertical overlay list for easier tapping */
  .header-nav.open nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem; /* Increase gap for tap targets */
    padding: 1rem; /* Better padding inside the overlay */
    background: none; /* Remove background gradient */
    border-radius: 0; /* Remove border radius */
    height: auto; /* Don't force 100% height here */
    /* gap: 0.25rem;
    padding: 0.5rem 0.25rem;
    background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.0));
    border-radius: 6px;
    height: 100%; */
  }

  .header-nav.open nav li { margin: 0; }
  .header-nav.open nav a { display: block; padding: 0.5rem 0.6rem; font-size: 0.95rem; }

  .App-header h1 {
    font-size: 1.2rem; /* smaller heading on mobile */
    line-height: 1.05;
  }

  .header-nav nav ul {
    /* Keep nav items horizontal and force a single row; each item stretches
       so links fill the top bar. On very small screens we scale sizes down
       rather than stacking to preserve the desktop layout visually. */
    flex-direction: column;
    gap: 0.35rem;
    align-items: stretch;
    width: 100%;
    flex-wrap: nowrap;
  }

  .header-nav nav li {
    /* Keep nav horizontal on small screens and stretch items across the width */
    flex-direction: row;
    gap: 0.25rem;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    flex-wrap: nowrap;
  }

  .footer-nav {
    position: fixed !important;
    left: 0; right: 0; bottom: 0; z-index: 1000;
    padding: 0.18rem 0.25rem !important;
    min-height: 30px !important;
  }

  /* Force footer/nav links to fill width on small screens */
  .footer-nav nav ul {
    display: flex !important;
    flex-direction: row !important;
    justify-content: flex-start !important;
    align-items: center !important;
    width: 100% !important;
    gap: 0.12rem !important;
    flex-wrap: nowrap !important; /* prevent wrapping */
  }

  .footer-nav nav li,
  .header-nav nav li {
    /* flex: 1 1 auto; */
    flex: 0 0 auto !important; /* don't grow; allow items to size to content */
    margin: 0 0.12rem !important;
    text-align: center !important;
    padding: 0 !important;
  }
  /* Make nav anchors compact and prevent wrapping */
  .header-nav a, .footer-nav a {
    display: inline-block !important;
    padding: 0.08rem 0.12rem !important;
    font-size: 0.36rem !important; /* even smaller */
    white-space: nowrap !important; /* keep label on one line */
  }
  /* Make list items and anchors stretch evenly across the bar */
  .header-nav nav ul, .footer-nav nav ul { display:flex !important; }
  .header-nav nav li, .footer-nav nav li { flex: 1 1 0 !important; }
  .header-nav nav a, .footer-nav nav a { display:block !important; width:100% !important; 
  }
  .workout-list {
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)) !important;
    gap: 0.25rem !important;
    padding: 0 0.15rem !important;
  }
  .exercise-card {
    padding: 0.12rem !important;
    font-size: 0.7rem !important;
    min-height: 0 !important; /* allow aspect-ratio to control size */
  }
  
  /* Add padding to main so content isn't hidden behind fixed header/footer */
  body main,
  main.main-content,
  main { 
    padding-top: 400px !important; 
    padding-bottom: 56px !important;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  /* Special spacing for auth pages */
  main .auth-page-container {
    padding-top: 420px !important;
  }
  
  /* Landscape phones: make footer non-fixed so it pushes content (avoid overlay and extra scroll) */
  @media (orientation: landscape) {
    .footer-nav { position: relative !important; left: auto !important; right: auto !important; bottom: auto !important; padding: 0.2rem 0.3rem !important; }
    main { padding-bottom: 20px !important; }
  }
}

/* Ensure header nav matches footer nav in narrow landscape viewports
   (centered, compressed, no-wrap). These rules are high-specificity and
   appended here so they override other mobile rules. */
@media (orientation: landscape) and (max-width: 900px) {
  /* Make header area slightly tighter to free horizontal space */
  .App-header { padding-left: 8px !important; padding-right: 8px !important; }

  /* Force header nav to center and match footer sizing */
  .header-nav,
  .header-nav nav ul { 
    display: flex !important; 
    justify-content: center !important; 
    align-items: center !important; 
    gap: 6px !important; 
    flex-wrap: nowrap !important; 
  }

  .header-nav nav li { 
    flex: 0 0 auto !important; 
    margin: 0 !important; 
    padding: 0 !important; 
  }

  .header-nav a { 
    font-size: 0.5rem !important; 
    padding: 3px 6px !important; 
    white-space: nowrap !important; 
    display: inline-block !important; 
  }

  /* Reduce title slightly in landscape to give links more room */
  .App-header h1 { font-size: 1.4rem !important; }

  /* Ensure footer remains centered and uses same sizing */
  .footer-nav nav ul { justify-content: center !important; gap: 6px !important; flex-wrap: nowrap !important; }
  .footer-nav a { font-size: 0.5rem !important; padding: 3px 6px !important; }
}

/* Source-level final landscape override (highest specificity) */
@media (orientation: landscape) and (max-width: 900px) {
  .header-nav nav ul { 
    justify-content: center !important; 
    gap: 4px !important; 
    flex-wrap: nowrap !important;
  }
  .header-nav nav li { 
    flex: 0 0 auto !important; 
    margin: 0 !important; 
    padding: 0 !important;
  }
  .header-nav a { 
    font-size: 0.46rem !important; 
    padding: 2px 6px !important; 
    white-space: nowrap !important; 
    display: inline-block !important;
  }
  .App-header h1 { 
    font-size: 1.1rem !important; 
  }
}

/* Increase header/banner thickness on wide landscape displays (min-width: 900px) */
@media (min-width: 900px) and (orientation: landscape) {
  .App-header {
    /* make the blue banner noticeably thicker in landscape */
    min-height: 200px !important;
    height: 200px !important;
    padding-top: 1.25rem !important;
    padding-bottom: 1.25rem !important;
  }

  .App-header h1 {
    font-size: 2.0rem !important; /* slightly larger title to match taller banner */
    line-height: 1.05 !important;
    margin-top: 0.25rem !important;
  }
}

/* Extra-small devices: tighten spacing and font sizes further */
@media (max-width: 420px) {
  .App-header {
    min-height: 84px;
    padding: 0.5rem 0.5rem;
  }
  .App-header h1 {
    font-size: 1.0rem;
  }
  .header-nav a {
    font-size: 0.95rem;
    padding: 0.4rem 0.25rem;
    display: block;
  }
  .controls .form-fields {
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }
  .controls label {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: center;
  }
}

/* Removed duplicate main rule that was conflicting with header spacing */

.header-nav {
  padding-bottom: 0; 
}

.footer-nav {
  background-color: var(--primary-color);
  box-shadow: var(--box-shadow);
  margin-top: 1.25rem;
  /* do not force a large min-height; let content size naturally */
  min-height: auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* place the logo near top and links toward bottom when space allows */
  align-items: center;
  padding: 1rem;
}

.footer-nav nav ul,
.header-nav nav ul {
  list-style: none;
  padding: 0;
  display: flex;
  /* prefer space-between so items stretch across the bar; allow wrapping on smaller screens */
  justify-content: space-between;
  flex-wrap: wrap;
  margin: 0;
}

.footer-nav nav li,
.header-nav nav li {
  margin: 0 0.5rem;
  flex: 0 1 auto;
}

.footer-nav a,
.header-nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
  display: inline-block;
  padding: 0.35rem 0.5rem;
}

.footer-nav a:hover,
.header-nav a:hover {
  text-decoration: underline;
}

main {
  flex-grow: 1;
  /* Removed conflicting padding - header spacing handled elsewhere */
}

.controls {
  margin-bottom: 2rem;
}

.controls label, .controls select, .controls button {
  font-size: 1.1rem;
  margin: 0 0.5rem;
}

.controls select, .controls button {
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  border: 1px solid var(--secondary-color);
}

.controls button {
  background-color: var(--primary-color);
  color: white;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.controls button:hover {
  background-color: #0056b3;
}

.controls button:disabled {
  background-color: #cccccc;
  cursor: not-allowed;
}

.error-message {
  color: #dc3545;
  margin-top: 1rem;
}

footer {
  padding: 1rem;
  background-color: var(--secondary-color);
  color: white;
}

/* Mobile styles for auth elements (responsive design handled in main media query) */
@media (max-width: 768px) {
  /* Additional mobile-specific styles can go here if needed */
}
