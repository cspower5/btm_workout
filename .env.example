## Example env vars. Copy to .env and fill values for local development.
# Either provide MONGO_URI (Atlas) OR provide MONGO_USER, MONGO_PASS, MONGO_HOST

# MongoDB (Atlas recommended)
MONGO_URI=
MONGO_DB=btm_workout_db

# Or local connection components
MONGO_USER=
MONGO_PASS=
MONGO_HOST=localhost

# RapidAPI key for database_refresh
RAPIDAPI_KEY=
