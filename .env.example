## Example env vars. Copy to .env and fill values for local development.
# Either provide MONGO_URI (Atlas) OR provide MONGO_USER, MONGO_PASS, MONGO_HOST

# MongoDB (Atlas recommended)
MONGO_URI=
MONGO_DB=btm_workout_db

# Or local connection components
MONGO_USER=
MONGO_PASS=
MONGO_HOST=localhost

# RapidAPI key for database_refresh
RAPIDAPI_KEY=

# CORS / Debugging
FLASK_ALLOW_DEV_ORIGINS=0
FLASK_CORS_DEBUG=0

# Admin preview token (protects the /api/v1/admin/allowed_origins endpoint)
# Use a strong random token in production and set it in your host provider (Render, Heroku, etc.)
# ADMIN_PREVIEW_TOKEN=replace_with_a_strong_token

# Optional overrides
# PORT=5000
# LOG_LEVEL=info
